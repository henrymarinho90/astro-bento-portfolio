---
import RomaLayout from '../../layouts/RomaLayout.astro';
import { getWebsiteContent } from '../../lib/website-content';
interface Props {
  locale: 'es' | 'en';
  kind: 'blog' | 'project';
  canonicalPath?: string;
  projects: { slug: string; title: string; description?: string; image?: string | null; date_created?: string }[];
}
const { locale, kind, projects, canonicalPath } = Astro.props;
const site = await getWebsiteContent(locale);
const {globals, common} = site;
const es = locale === 'es';
const blog = kind === 'blog';
const title = blog ? common.blog_title : common.projects_title;
const description = blog
  ? common.blog_description
  : common.projects_description;
---
<RomaLayout locale={locale} content={site} title={`${title} — ${globals.seo_suffix}`} description={description} canonicalPath={canonicalPath || `/${locale}/${kind}/`}>
  <section class="roma-container roma-section">
    <header class="section-heading">
      <p class="eyebrow">{common.archive_eyebrow}</p>
      <h1 class="roma-t-h1">{title}</h1>
      <p>{description}</p>
      {common.archive_note && <p class="article-note">{common.archive_note}</p>}
      <a class="text-link" href={`/${locale}/${blog ? 'project' : 'blog'}/`}>{blog ? common.archive_projects_link : common.archive_blog_link} →</a>
    </header>
    <div class="archive-grid">
      {projects.map((project) => {
        const href = `/${locale}/${kind}/${project.slug}/`;
        const date = project.date_created ? new Date(project.date_created) : null;
        const validDate = date && !Number.isNaN(date.valueOf()) ? date : null;
        return <article class="entry-card">
          {project.image && <a href={href} tabindex="-1" aria-hidden="true"><img src={`https://cms.romahomestore.com/assets/${project.image}?width=800&height=450&fit=cover&format=webp&quality=80`} alt="" width="800" height="450" loading="lazy" decoding="async" /></a>}
          <div class="entry-card-body">
            <p class="eyebrow">{common.archive_entry_label}</p>
            <h2 class="roma-t-h3"><a href={href}>{project.title}</a></h2>
            {validDate && <time datetime={validDate.toISOString()}>{new Intl.DateTimeFormat(es ? 'es-CO' : 'en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(validDate)}</time>}
            <p>{project.description}</p>
            <a class="text-link" href={href}>{common.archive_read_label} →</a>
          </div>
        </article>;
      })}
    </div>
    {projects.length === 0 && <p>{common.archive_empty}</p>}
  </section>
</RomaLayout>
