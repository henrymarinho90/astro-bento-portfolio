---
import RomaLayout from '../../layouts/RomaLayout.astro';
interface Props {
  locale: 'es' | 'en';
  kind: 'blog' | 'project';
  canonicalPath?: string;
  projects: { slug: string; title: string; description?: string; image?: string | null; date_created?: string }[];
}
const { locale, kind, projects, canonicalPath } = Astro.props;
const es = locale === 'es';
const blog = kind === 'blog';
const title = blog ? (es ? 'Artículos y casos de estudio' : 'Articles and case studies') : (es ? 'Proyectos' : 'Projects');
const description = blog
  ? (es ? 'Artículos y casos de estudio publicados por Henry Mariño sobre analítica, automatización y desarrollo asistido por IA.' : 'Published articles and case studies by Henry Mariño on analytics, automation and AI-assisted development.')
  : (es ? 'Proyectos reales de analítica de datos, inteligencia de negocios y automatización de Henry Mariño.' : 'Real data analytics, business intelligence and automation projects by Henry Mariño.');
---
<RomaLayout locale={locale} title={`${title} — Roma Consulting`} description={description} canonicalPath={canonicalPath || `/${locale}/${kind}/`}>
  <section class="roma-container roma-section">
    <header class="section-heading">
      <p class="eyebrow">{es ? 'Conocimiento aplicado' : 'Applied knowledge'}</p>
      <h1 class="roma-t-h1">{title}</h1>
      <p>{description}</p>
      {es && <p class="article-note">Los títulos y contenidos originales se conservan en inglés. Este archivo reúne los proyectos y artículos ya publicados, sin traducciones automáticas.</p>}
      <a class="text-link" href={`/${locale}/${blog ? 'project' : 'blog'}/`}>{blog ? (es ? 'Ver como proyectos' : 'Browse as projects') : (es ? 'Ver artículos y casos de estudio' : 'Browse articles and case studies')} →</a>
    </header>
    <div class="archive-grid">
      {projects.map((project) => {
        const href = `/${locale}/${kind}/${project.slug}/`;
        const date = project.date_created ? new Date(project.date_created) : null;
        const validDate = date && !Number.isNaN(date.valueOf()) ? date : null;
        return <article class="entry-card">
          {project.image && <a href={href} tabindex="-1" aria-hidden="true"><img src={`https://cms.romahomestore.com/assets/${project.image}?width=800&height=450&fit=cover&format=webp&quality=80`} alt="" width="800" height="450" loading="lazy" decoding="async" /></a>}
          <div class="entry-card-body">
            <p class="eyebrow">{es ? 'Artículo / caso de estudio' : 'Article / case study'}</p>
            <h2 class="roma-t-h3"><a href={href}>{project.title}</a></h2>
            {validDate && <time datetime={validDate.toISOString()}>{new Intl.DateTimeFormat(es ? 'es-CO' : 'en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(validDate)}</time>}
            <p>{project.description}</p>
            <a class="text-link" href={href}>{es ? 'Leer caso de estudio' : 'Read case study'} →</a>
          </div>
        </article>;
      })}
    </div>
    {projects.length === 0 && <p>{es ? 'Todavía no hay publicaciones disponibles.' : 'No published entries are available yet.'}</p>}
  </section>
</RomaLayout>
