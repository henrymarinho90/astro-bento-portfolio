---
import RomaLayout from '../../layouts/RomaLayout.astro';
interface Props { locale: 'es' | 'en'; projects: {slug:string;title:string;description?:string;image?:string|null;date_created?:string}[] }
const {locale, projects} = Astro.props;
const es = locale === 'es';
const base = `/${locale}`;
const jobs = [
 {company:'Fountain Forward', role:'Analytics Director', year:'2025'},
 {company:'Fountain Forward', role:'Senior Analyst', year:'2022'},
 {company:'Conduent', role:'Workforce Development Manager', year:'2022'},
 {company:'Teleperformance', role:'WFM Junior Analyst', year:'2021'},
];
const tools=['SQL','Python','Power BI','Tableau','Directus','Astro','Git','Metabase','Vibe Coding','Excel','Google/Meta Ads'];
---
<RomaLayout locale={locale} title={es ? 'ROMA — Asesoría jurídica, datos e inteligencia artificial' : 'ROMA — Legal advice, data & artificial intelligence'} description={es ? 'Tatiana Rodriguez y Henry Mariño. Servicios jurídicos en Colombia y consultoría de datos e IA para Latinoamérica.' : 'Tatiana Rodriguez and Henry Mariño. Legal services in Colombia. Data and AI consulting across Latin America.'}>
 <aside class="section-rail" aria-label={es ? 'En esta página' : 'On this page'}>
  <a href="#servicios">01 <span>{es?'Servicios':'Services'}</span></a><a href="#nosotros">02 <span>{es?'Equipo':'Team'}</span></a><a href="#publicaciones">03 <span>Blog</span></a><a href="#contacto">04 <span>{es?'Contacto':'Contact'}</span></a>
 </aside>
 <section class="hero roma-container" aria-labelledby="hero-title">
  <div class="hero-copy">
   <p class="eyebrow">RODRÍGUEZ MARIÑO CONSULTING</p>
   <h1 id="hero-title">{es?'Rigor jurídico.':'Legal rigor.'}<br /><em>{es?'Precisión analítica.':'Analytical precision.'}</em></h1>
   <p class="hero-intro">{es?'Dos disciplinas. Una forma de trabajar: entender tu situación, ordenar la información y acompañarte en decisiones bien fundamentadas.':'Two disciplines. One approach: understand your situation, organize the information, and help you make well-grounded decisions.'}</p>
   <div class="hero-actions"><a class="roma-btn roma-btn--primario" href="#servicios">{es?'Conoce nuestros servicios':'Explore our services'} <span aria-hidden="true">↗</span></a><a class="text-link" href="#nosotros">{es?'Quiénes somos':'Meet the team'}</a></div>
   <p class="hero-territory">{es?'Datos e IA · Latinoamérica / Legal · Colombia':'Data & AI · Latin America / Legal · Colombia'}</p>
  </div>
  <div class="hero-signature" aria-label="ROMA">
   <img class="brand-symbol" src="/roma/assets/logo/roma-simbolo-tinta.svg" width="240" height="240" alt="" />
   <p>{es?'Todos los datos':'All data'}<br />{es?'llevan a ROMA.':'leads to ROMA.'}</p>
   <span class="signature-foot">{es?'Derecho + datos':'Law + data'}</span>
  </div>
 </section>
 <section id="servicios" class="roma-section roma-section--alt">
  <div class="roma-container">
   <div class="section-heading"><p class="eyebrow">01 — {es?'Servicios':'Services'}</p><h2>{es?'El punto de partida es tu necesidad.':'Your needs are the starting point.'}</h2></div>
   <div class="practice-grid">
    <article class="practice practice-legal"><p class="eyebrow legal">{es?'Legal · Colombia':'Legal · Colombia'}</p><h3>{es?'Asesoría jurídica':'Legal advice'}</h3><p>{es?'Acompañamiento en asuntos civiles, de tierras y de familia. Una revisión clara de tu situación para definir el siguiente paso.':'Guidance on civil, land and family matters. A clear review of your situation to determine the next step.'}</p><ul><li>{es?'Derecho civil':'Civil law'}</li><li>{es?'Tierras e inmuebles':'Land and property'}</li><li>{es?'Derecho de familia':'Family law'}</li></ul><p class="practice-person">Tatiana Rodriguez</p><a class="text-link" href={`${base}/servicios/legal/`}>{es?'Ver el área jurídica':'Explore legal services'} <span aria-hidden="true">↗</span></a><small>{es?'Servicios jurídicos exclusivamente en Colombia.':'Legal services exclusively in Colombia.'}</small></article>
    <article class="practice practice-data"><p class="eyebrow data">{es?'Datos e IA · Latinoamérica':'Data & AI · Latin America'}</p><h3>{es?'De la información a la decisión':'From information to decisions'}</h3><p>{es?'Analítica, ingeniería de datos e inteligencia artificial para conectar tus fuentes de información con las decisiones de tu negocio.':'Analytics, data engineering and artificial intelligence that connect your information sources to business decisions.'}</p><ul><li>{es?'Analítica y business intelligence':'Analytics and business intelligence'}</li><li>{es?'Ingeniería y calidad de datos':'Data engineering and quality'}</li><li>{es?'Automatización, IA y data science':'Automation, AI and data science'}</li></ul><p class="practice-person">Henry Mariño</p><a class="text-link" href={`${base}/servicios/data/`}>{es?'Ver el área de datos':'Explore data services'} <span aria-hidden="true">↗</span></a><small>{es?'Colombia y otros países de Latinoamérica.':'Colombia and other Latin American countries.'}</small></article>
   </div>
  </div>
 </section>
 <section id="nosotros" class="roma-section roma-container">
  <div class="section-heading"><p class="eyebrow">02 — {es?'Quiénes somos':'Who we are'}</p><h2>{es?'Dos perspectivas. Trabajo con criterio.':'Two perspectives. Thoughtful work.'}</h2><p>{es?'ROMA reúne nuestras prácticas profesionales sin confundir sus responsabilidades: cada área tiene su enfoque y su profesional a cargo.':'ROMA brings our professional practices together while keeping responsibilities clear: each area has its own focus and lead professional.'}</p></div>
  <div class="team-grid">
   <article class="person" data-professional="tatiana"><p class="eyebrow legal">{es?'Área jurídica':'Legal practice'}</p><h3>Tatiana Rodriguez</h3><p class="person-role">{es?'Abogada · Civil, tierras y familia':'Lawyer · Civil, land and family matters'}</p><p>{es?'Acompañamiento jurídico en Colombia, con atención al contexto y a las necesidades de cada consulta.':'Legal guidance in Colombia, with attention to the context and needs of each inquiry.'}</p><div data-linkedin-slot="tatiana" hidden></div></article>
   <article class="person" data-professional="henry"><p class="eyebrow data">{es?'Datos e inteligencia artificial':'Data & artificial intelligence'}</p><h3>Henry Mariño</h3><p class="person-role">{es?'Ingeniero industrial · Analítica, IA y datos':'Industrial engineer · Analytics, AI and data'}</p><p>{es?'Análisis de datos, ingeniería de datos, data science y automatización. Experiencia liderando equipos de analítica y conectando indicadores con decisiones de negocio.':'Data analysis, data engineering, data science and automation. Experience leading analytics teams and connecting performance indicators with business decisions.'}</p><a class="text-link" href="https://linkedin.com/in/henrymarinho90/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><div data-linkedin-slot="henry" hidden></div></article>
  </div>
  <details class="experience"><summary>{es?'Trayectoria y herramientas de Henry':'Henry’s experience and toolkit'}</summary><div class="experience-grid">{jobs.map(job=><div><span class="eyebrow">{job.year}</span><h4>{job.company}</h4><p>{job.role}</p></div>)}</div><ul class="toolkit">{tools.map(tool=><li>{tool}</li>)}</ul></details>
 </section>
 <section id="publicaciones" class="roma-section roma-section--alt">
  <div class="roma-container"><div class="section-heading section-heading--split"><div><p class="eyebrow">03 — Blog & {es?'proyectos':'projects'}</p><h2>{es?'Trabajo que puedes explorar.':'Work you can explore.'}</h2></div><a class="text-link" href={`${base}/blog/`}>{es?'Ver el archivo completo':'Browse the full archive'} <span aria-hidden="true">↗</span></a></div>
   <div class="archive-grid">{projects.map(project=><article class="entry-card"><p class="eyebrow data">{es?'Datos · Caso y artículo':'Data · Case study & article'}</p><h3><a href={`${base}/blog/${project.slug}/`}>{project.title}</a></h3><p>{project.description}</p><a class="text-link" href={`${base}/blog/${project.slug}/`}>{es?'Leer el contenido original':'Read the original'} <span aria-hidden="true">↗</span></a></article>)}</div>
   <p class="archive-note">{es?'Conservamos los artículos y proyectos existentes en su idioma original; algunos están en inglés.':'Existing articles and projects are preserved in their original language, including English.'}</p>
  </div>
 </section>
 <section id="contacto" class="roma-section roma-container contact-section"><div><p class="eyebrow">04 — {es?'Contacto':'Contact'}</p><h2>{es?'Conversemos sobre tu situación.':'Let’s talk about your situation.'}</h2><p>{es?'Cuéntanos el área de tu consulta y qué necesitas resolver. No envíes expedientes, documentos de identidad ni información sensible en el primer mensaje.':'Tell us which practice you need and what you are trying to resolve. Please do not include case files, identity documents or sensitive information in your first message.'}</p></div><div class="contact-actions"><a class="roma-btn roma-btn--primario" href="mailto:henrymarinho90@gmail.com?subject=ROMA%20-%20Datos%20e%20IA">{es?'Consultar sobre Datos e IA':'Data & AI inquiry'} <span aria-hidden="true">↗</span></a><a class="roma-btn roma-btn--secundario" href="mailto:henrymarinho90@gmail.com?subject=ROMA%20-%20Coordinacion%20de%20consulta%20juridica">{es?'Coordinar consulta jurídica':'Coordinate a legal inquiry'}</a><small>{es?'Coordinación inicial con Henry. El canal directo de Tatiana se añadirá cuando esté confirmado. Asesoría jurídica solo en Colombia.':'Initial coordination with Henry. Tatiana’s direct contact will be added once confirmed. Legal advice is available only in Colombia.'}</small></div></section>
</RomaLayout>
