---
import RomaLayout from '../../layouts/RomaLayout.astro';
import { getWebsiteContent } from '../../lib/website-content';
interface Props { locale: 'es' | 'en'; projects: {slug:string;title:string;description?:string;image?:string|null;date_created?:string}[] }
const {locale, projects} = Astro.props;
const site = await getWebsiteContent(locale);
const home = site.home;
const {globals, common, practices, people} = site;
const base = `/${locale}`;
const jobs = people.henry.jobs;
const tools = people.henry.tools;
---
<RomaLayout locale={locale} content={site} title={home.seo_title} description={home.seo_description}>
 <aside class="section-rail" aria-label={home.rail_label}>
  <a href="#servicios">01 <span>{home.rail_services}</span></a><a href="#nosotros">02 <span>{home.rail_team}</span></a><a href="#publicaciones">03 <span>{common.navigation.find(item=>item.target==='blog')?.label}</span></a><a href="#contacto">04 <span>{home.rail_contact}</span></a>
 </aside>
 <section class="hero roma-container" aria-labelledby="hero-title">
  <div class="hero-copy">
   <p class="eyebrow">{globals.brand_eyebrow}</p>
   <h1 id="hero-title">{home.hero_title}<br /><em>{home.hero_accent}</em></h1>
   <p class="hero-intro">{home.hero_description}</p>
   <div class="hero-actions"><a class="roma-btn roma-btn--primario" href="#servicios">{home.hero_primary_label} <span aria-hidden="true">↗</span></a><a class="text-link" href="#nosotros">{home.hero_secondary_label}</a></div>
   <p class="hero-territory">{home.hero_territory}</p>
  </div>
  <div class="hero-signature" aria-label={globals.symbol_label}>
   <img class="brand-symbol" src={globals.symbol_image} width="240" height="240" alt="" />
   <p>{home.signature_title}<br />{home.signature_accent}</p>
   <span class="signature-foot">{home.signature_label}</span>
  </div>
 </section>
 <section id="servicios" class="roma-section roma-section--alt">
  <div class="roma-container">
   <div class="section-heading"><p class="eyebrow">01 — {home.services_label}</p><h2>{home.services_title}</h2></div>
   <div class="practice-grid">
    <article class="practice practice-legal"><p class="eyebrow legal">{practices.legal.card_label}</p><h3>{practices.legal.card_title}</h3><p>{practices.legal.card_description}</p><ul>{practices.legal.card_items.map(item=><li>{item.label}</li>)}</ul><p class="practice-person">{people.tatiana.name}</p><a class="text-link" href={`${base}/servicios/legal/`}>{practices.legal.card_link_label} <span aria-hidden="true">↗</span></a><small>{practices.legal.territory}</small></article>
    <article class="practice practice-data"><p class="eyebrow data">{practices.data.card_label}</p><h3>{practices.data.card_title}</h3><p>{practices.data.card_description}</p><ul>{practices.data.card_items.map(item=><li>{item.label}</li>)}</ul><p class="practice-person">{people.henry.name}</p><a class="text-link" href={`${base}/servicios/data/`}>{practices.data.card_link_label} <span aria-hidden="true">↗</span></a><small>{practices.data.territory}</small></article>
   </div>
  </div>
 </section>
 <section id="nosotros" class="roma-section roma-container">
  <div class="section-heading"><p class="eyebrow">02 — {home.team_label}</p><h2>{home.team_title}</h2><p>{home.team_description}</p></div>
  <div class="team-grid">
   <article class="person" data-professional="tatiana"><p class="eyebrow legal">{people.tatiana.label}</p><h3>{people.tatiana.name}</h3><p class="person-role">{people.tatiana.role}</p><p>{people.tatiana.bio}</p>{people.tatiana.linkedin_url && <a class="text-link" href={people.tatiana.linkedin_url} target="_blank" rel="noopener noreferrer">{people.tatiana.linkedin_label} <span aria-hidden="true">↗</span></a>}<div data-linkedin-slot="tatiana" hidden></div></article>
   <article class="person" data-professional="henry"><p class="eyebrow data">{people.henry.label}</p><h3>{people.henry.name}</h3><p class="person-role">{people.henry.role}</p><p>{people.henry.bio}</p>{people.henry.linkedin_url && <a class="text-link" href={people.henry.linkedin_url} target="_blank" rel="noopener noreferrer">{people.henry.linkedin_label} <span aria-hidden="true">↗</span></a>}<div data-linkedin-slot="henry" hidden></div></article>
  </div>
  <details class="experience"><summary>{people.henry.experience_label}</summary><div class="experience-grid">{jobs.map(job=><div><span class="eyebrow">{job.year}</span><h4>{job.company}</h4><p>{job.role}</p></div>)}</div><ul class="toolkit">{tools.map(tool=><li>{tool.name}</li>)}</ul></details>
 </section>
 <section id="publicaciones" class="roma-section roma-section--alt">
  <div class="roma-container"><div class="section-heading section-heading--split"><div><p class="eyebrow">03 — {home.publications_label}</p><h2>{home.publications_title}</h2></div><a class="text-link" href={`${base}/blog/`}>{home.archive_label} <span aria-hidden="true">↗</span></a></div>
   <div class="archive-grid">{projects.map(project=><article class="entry-card"><p class="eyebrow data">{home.entry_label}</p><h3><a href={`${base}/blog/${project.slug}/`}>{project.title}</a></h3><p>{project.description}</p><a class="text-link" href={`${base}/blog/${project.slug}/`}>{home.entry_link_label} <span aria-hidden="true">↗</span></a></article>)}</div>
   <p class="archive-note">{home.original_note}</p>
  </div>
 </section>
 <section id="contacto" class="roma-section roma-container contact-section"><div><p class="eyebrow">04 — {home.contact_label}</p><h2>{home.contact_title}</h2><p>{home.contact_description}</p></div><div class="contact-actions"><a class="roma-btn roma-btn--primario" href={globals.data_contact_url}>{home.data_contact_label} <span aria-hidden="true">↗</span></a><a class="roma-btn roma-btn--secundario" href={globals.legal_contact_url}>{home.legal_contact_label}</a><small>{home.contact_note}</small></div></section>
</RomaLayout>
