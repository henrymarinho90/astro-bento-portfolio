---
/**
 * Google Tag Manager (one container for GA4, Google Ads and future tags) with Consent Mode v2 ADVANCED.
 * See docs/analytics.md and docs/gtm-setup.md.
 * - <head>, before anything else Google-related: consent default (everything that stores or reads identifiers
 *   denied), ads_data_redaction, no url_passthrough, and the stored choice (if any) applied as an update;
 *   then the official GTM snippet. GTM always loads; without consent Google only gets cookieless pings.
 * - The banner emits 'roma:consent' {analytics, ads}; this module sends consent update + a 'consent_update'
 *   dataLayer event and deletes the cookies of every denied category.
 * - Events are dataLayer pushes; GTM maps them to GA4/Ads tags. Never any personal data.
 * Rendered only in production builds, outside PUBLIC_NOINDEX previews, with a valid GTM ID.
 * The <noscript> iframe lives in GtmNoscript.astro (right after <body>).
 */
import { gtmBootstrap } from '../../lib/consent.mjs';
interface Props { gtmId?: string }
const { gtmId = '' } = Astro.props;
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
const bootstrap = import.meta.env.PROD && !noindex ? gtmBootstrap(gtmId) : '';
---
{bootstrap && <>
 <script is:inline set:html={bootstrap} />
 <script>
  import { clientIdFromCookie, consentSignals, cookieDomains, cookiesToDelete } from '../../lib/consent.mjs';
  type Choice = { analytics: boolean; ads: boolean };
  type Params = Record<string, string | undefined>;
  const w = window as unknown as { dataLayer?: unknown[]; gtag?: (...args: unknown[]) => void; __romaConsent?: Choice | null };
  // Every push sets ALL tracked keys: GTM's data layer model keeps old values, so a stale `location` from a
  // previous event must never leak into the next one. undefined resets a key.
  const push = (event: string, params: Params = {}) => {
   try {
    w.dataLayer?.push({ event, area: undefined, location: undefined, method: undefined, language_from: undefined, language_to: undefined, locale: document.documentElement.lang === 'en' ? 'en' : 'es', ...params });
   } catch { /* analytics must never break the page */ }
  };
  const gtag = (...args: unknown[]) => { try { w.gtag?.(...args); } catch { /* idem */ } };
  const CLICK_EVENTS: Record<string, (d: DOMStringMap) => [string, Params]> = {
   cta_click: d => ['cta_click', { area: d.area || 'none', location: d.location || 'none' }],
   whatsapp_click: d => ['contact', { method: 'whatsapp', area: d.area || 'none', location: d.location || 'none' }],
   email_click: d => ['contact', { method: 'email', area: d.area || 'none', location: d.location || 'none' }],
  };
  const PENDING_KEY = 'roma_lead_pending';
  const PENDING_TTL_MS = 10 * 60 * 1000;
  const cleanArea = (value: unknown) => (value === 'legal' || value === 'data' ? value : 'none');

  // ---------------------------------------------------------------- consent (idempotent)
  // The <head> bootstrap already applied the stored choice before GTM loaded.
  let current: Choice = { analytics: Boolean(w.__romaConsent?.analytics), ads: Boolean(w.__romaConsent?.ads) };
  const setClientIdInputs = (value: string) => document.querySelectorAll<HTMLInputElement>('input[name="ga_client_id"]').forEach(input => { input.value = value; });
  const clientId = () => (current.analytics ? clientIdFromCookie(document.cookie) : '');
  function deleteCookies(choice: Choice) {
   for (const name of cookiesToDelete(document.cookie, choice)) for (const d of cookieDomains(location.hostname)) {
    document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${d ? `; domain=${d}` : ''}`;
   }
  }
  function applyConsent(next: Choice) {
   const changed = next.analytics !== current.analytics || next.ads !== current.ads;
   current = next;
   if (!next.analytics) setClientIdInputs('');
   deleteCookies(next); // no-op when every category is granted
   if (!changed) return;
   gtag('consent', 'update', consentSignals(next));
   try { w.dataLayer?.push({ event: 'consent_update', analytics: next.analytics, ads: next.ads }); } catch { /* idem */ }
  }
  window.addEventListener('roma:consent', event => {
   const detail = (event as CustomEvent).detail as Partial<Choice> | null;
   if (detail && typeof detail.analytics === 'boolean' && typeof detail.ads === 'boolean') applyConsent({ analytics: detail.analytics, ads: detail.ads });
  });

  // ---------------------------------------------------------------- events (no PII)
  document.addEventListener('click', event => {
   const target = event.target as Element | null;
   const tracked = target?.closest<HTMLElement>('[data-track]');
   const build = tracked && CLICK_EVENTS[tracked.dataset.track || ''];
   if (tracked && build) push(...build(tracked.dataset));
   const lang = target?.closest<HTMLElement>('[data-locale]');
   if (lang && (lang.dataset.locale === 'es' || lang.dataset.locale === 'en')) {
    push('lang_switch', { language_from: document.documentElement.lang === 'en' ? 'en' : 'es', language_to: lang.dataset.locale });
   }
  }, { capture: true });

  const startedForms = new WeakSet<HTMLFormElement>();
  const areaOf = (form: HTMLFormElement) => cleanArea(new FormData(form).get('area') ?? form.dataset.area);
  document.addEventListener('input', event => {
   const form = (event.target as Element | null)?.closest<HTMLFormElement>('form[data-track-form]');
   if (!form || startedForms.has(form)) return;
   startedForms.add(form);
   push('lead_form_start', { area: areaOf(form), location: form.dataset.trackForm || 'none' });
  }, { capture: true });

  document.addEventListener('submit', event => {
   const form = (event.target as Element | null)?.closest<HTMLFormElement>('form[data-track-form]');
   if (!form) return;
   const area = areaOf(form);
   const input = form.elements.namedItem('ga_client_id') as HTMLInputElement | null;
   if (input) input.value = clientId(); // empty unless analytics_storage is granted
   push('lead_form_submit', { area, location: form.dataset.trackForm || 'none' });
   try { sessionStorage.setItem(PENDING_KEY, JSON.stringify({ area, at: Date.now() })); } catch { /* storage blocked */ }
  }, { capture: true });

  // ---------------------------------------------------------------- /gracias/: one generate_lead per submitted form
  if (/^\/(?:(?:es|en)\/)?gracias\/?$/.test(location.pathname)) {
   try {
    const raw = sessionStorage.getItem(PENDING_KEY);
    sessionStorage.removeItem(PENDING_KEY); // a reload finds nothing and sends nothing
    const pending = raw ? JSON.parse(raw) : null;
    if (pending && Date.now() - Number(pending.at) < PENDING_TTL_MS) {
     const fromUrl = new URLSearchParams(location.search).get('area');
     push('generate_lead', { area: cleanArea(fromUrl ?? pending.area), method: 'form' });
    }
   } catch { /* storage blocked or malformed: no event */ }
  }
 </script>
</>}
