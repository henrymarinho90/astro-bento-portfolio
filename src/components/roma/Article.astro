---
import RomaLayout from '../../layouts/RomaLayout.astro';
import { safeExternalUrl, sanitizeArticleHtml } from '../../lib/rich-text.mjs';

interface Props {
  locale: 'es' | 'en';
  project: {
    slug: string;
    title: string;
    description?: string;
    content?: string | null;
    image?: string | null;
    date_created?: string;
    repo_link?: string | null;
    url?: string | null;
  };
}
const { locale, project } = Astro.props;
const es = locale === 'es';
const canonicalPath = `https://portfolio.romahomestore.com/project/${project.slug}/`;
const image = project.image ? `https://cms.romahomestore.com/assets/${project.image}?width=1200&height=630&fit=cover&format=webp&quality=80` : undefined;
const body = sanitizeArticleHtml(project.content);
const repo = safeExternalUrl(project.repo_link);
const demo = safeExternalUrl(project.url);
const date = project.date_created ? new Date(project.date_created) : null;
const validDate = date && !Number.isNaN(date.valueOf()) ? date : null;
---
<RomaLayout locale={locale} title={`${project.title} — Roma Consulting`} description={project.description || (es ? 'Proyecto y caso de estudio de Henry Mariño.' : 'Project and case study by Henry Mariño.')} canonicalPath={canonicalPath} article={true} pubDate={validDate?.toISOString()} image={image}>
  <section class="roma-container roma-section">
    <article>
      <header class="article-head">
        <a class="text-link" href={`/${locale}/blog/`}>← {es ? 'Todos los artículos y casos de estudio' : 'All articles and case studies'}</a>
        <p class="eyebrow">{es ? 'Datos · Artículos y casos de estudio' : 'Data · Articles and case studies'}</p>
        <h1 class="roma-t-h1">{project.title}</h1>
        <p>{project.description}</p>
        <p>{es ? 'Por' : 'By'} Henry Mariño{validDate && <> · <time datetime={validDate.toISOString()}>{new Intl.DateTimeFormat(es ? 'es-CO' : 'en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(validDate)}</time></>}</p>
        {es && <p class="article-note">Contenido original en inglés. La interfaz está en español; el artículo conserva su idioma y texto originales.</p>}
      </header>
      {image && <img class="article-cover" src={image} alt={project.title} width="1200" height="630" fetchpriority="high" />}
      {body ? <div class="prose-content" lang="en" set:html={body} /> : <p class="article-note">{es ? 'El CMS no incluye un texto ampliado para este proyecto.' : 'The CMS does not include a longer body for this project.'}</p>}
      {(repo || demo) && <nav class="article-links" aria-label={es ? 'Recursos del proyecto' : 'Project resources'}>
        {repo && <a class="text-link" href={repo} target="_blank" rel="noopener noreferrer">{es ? 'Ver recurso del proyecto' : 'View project resource'} ↗</a>}
        {demo && demo !== repo && <a class="text-link" href={demo} target="_blank" rel="noopener noreferrer">{es ? 'Ver proyecto en línea' : 'View live project'} ↗</a>}
      </nav>}
      <footer class="article-links">
        <a class="text-link" href={`/${locale}/project/`}>{es ? 'Explorar proyectos' : 'Explore projects'} →</a>
        <a class="text-link" href={`/${locale}/#contacto`}>{es ? 'Hablemos de tu proyecto' : 'Let’s discuss your project'} →</a>
      </footer>
    </article>
  </section>
</RomaLayout>
