---
import RomaLayout from '../../../layouts/RomaLayout.astro';
export function getStaticPaths(){return ['es','en'].flatMap(locale=>['legal','data'].map(practice=>({params:{locale,practice},props:{locale,practice}})));}
const {locale,practice}=Astro.props as {locale:'es'|'en';practice:'legal'|'data'};
const es=locale==='es',legal=practice==='legal';
const title=legal?(es?'Servicios jurídicos en Colombia':'Legal services in Colombia'):(es?'Datos e inteligencia artificial':'Data & artificial intelligence');
const intro=legal?(es?'Acompañamiento en asuntos civiles, de tierras y de familia, exclusivamente en Colombia.':'Guidance on civil, land and family matters, exclusively in Colombia.'):(es?'Analítica, ingeniería de datos y automatización para organizaciones en Colombia y Latinoamérica.':'Analytics, data engineering and automation for organizations in Colombia and Latin America.');
const items=legal?(es?['Derecho civil','Tierras e inmuebles','Derecho de familia']:['Civil law','Land and property','Family law']):(es?['Analítica y business intelligence','Ingeniería y calidad de datos','Automatización e inteligencia artificial','Data science']:['Analytics and business intelligence','Data engineering and quality','Automation and artificial intelligence','Data science']);
---
<RomaLayout locale={locale} title={`${title} — ROMA`} description={intro}>
 <section class="roma-section roma-container"><div class="service-detail"><a class="text-link" href={`/${locale}/`}>{es?'Volver a inicio':'Back to home'}</a><p class:list={['eyebrow',legal?'legal':'data']}>{legal?'Colombia':(es?'Latinoamérica':'Latin America')}</p><h1 class="roma-t-h1">{title}</h1><p class="roma-t-lead">{intro}</p><p>{legal?'Tatiana Rodriguez':'Henry Mariño'}</p><ul>{items.map(item=><li>{item}</li>)}</ul><p>{es?'Partimos de una conversación para entender tu situación y definir el alcance antes de proponer el trabajo.':'We start with a conversation to understand your situation and define the scope before proposing the work.'}</p>{legal&&<p class="article-note">{es?'La información de este sitio es general. La atención de una consulta no supone prometer resultados ni sustituye una revisión individual.':'The information on this site is general. An inquiry does not imply guaranteed results or replace an individual review.'}</p>}<div class="contact-actions"><a class="roma-btn roma-btn--primario" href={`/${locale}/#contacto`}>{es?'Conversemos':'Let’s talk'}</a>{!legal&&<a class="text-link" href={`/${locale}/project/`}>{es?'Explorar proyectos reales':'Explore real projects'}</a>}</div></div></section>
</RomaLayout>
