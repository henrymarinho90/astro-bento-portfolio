---
import Archive from '../../../components/roma/Archive.astro';
import { getPublishedProjects } from '../../../lib/directus';
import { localizeProject } from '../../../lib/project-locale.mjs';
export const prerender = true;
export function getStaticPaths() {
  return ['es', 'en'].map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale === 'en' ? 'en' : 'es';
const projects = (await getPublishedProjects()).map((project) => localizeProject(project, locale));
---
<Archive locale={locale} kind="blog" projects={projects} />
