---
import Archive from '../../../components/roma/Archive.astro';
import { getPublishedProjects } from '../../../lib/directus';
export const prerender = true;
export function getStaticPaths() {
  return ['es', 'en'].map((locale) => ({ params: { locale } }));
}
const projects = await getPublishedProjects();
const locale = Astro.params.locale === 'en' ? 'en' : 'es';
---
<Archive locale={locale} kind="project" projects={projects} />
