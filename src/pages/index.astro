---
import { chooseLocale, localePath } from '../lib/i18n.mjs';

export const prerender = false;

// Only a proxy that strips/overwrites client-supplied CF-IPCountry is trustworthy.
const country = import.meta.env.TRUST_PROXY_COUNTRY === 'true'
  ? Astro.request.headers.get('cf-ipcountry')
  : undefined;
const locale = chooseLocale({
  cookie: Astro.cookies.get('roma_locale')?.value,
  country,
  acceptLanguage: Astro.request.headers.get('accept-language'),
});

// This root-only route never runs for explicit /es/... or /en/... requests.
const response = Astro.redirect(localePath(locale), 302);
response.headers.set('Vary', 'Cookie, Accept-Language, CF-IPCountry');
response.headers.set('Cache-Control', 'private, no-store');
return response;
---
